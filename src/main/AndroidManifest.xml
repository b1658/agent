<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      Standalone manifest only for building the agent dex / dev testing. On-car there is no
      component here: tools/build-host-apk.sh compiles AgentBroadcaster + AgentProbe into
